---
const title = "Mon site";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <header>
      <h1>{title}</h1>
    </header>

    <main>
      <h2>Bienvenue 👋</h2>
      <p>Mon premier projet Astro.</p>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    color: #222;
  }

  header {
    padding: 20px 40px;
    background: #222;
    color: white;
  }

  main {
    max-width: 1000px;
    margin: 50px auto;
    padding: 20px;
  }

  h2 {
    margin-bottom: 10px;
  }
</style>
